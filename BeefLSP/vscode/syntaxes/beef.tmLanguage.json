{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Beef",
  "scopeName": "source.beef",
  "fileTypes": [
    "bf"
  ],
  "patterns": [
    {
      "include": "#preprocessor"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#modifiers"
    },
    {
      "include": "#primitive-types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.beef",
          "match": "^\\s*(#)\\s*(if|else|elif|endif|define|undef|include|error|warning|pragma|region|endregion)\\b(.*)$",
          "captures": {
            "1": {
              "name": "punctuation.definition.preprocessor.beef"
            },
            "2": {
              "name": "keyword.control.preprocessor.beef"
            },
            "3": {
              "name": "string.unquoted.preprocessor.beef"
            }
          }
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.beef",
          "begin": "/\\*\\*(?!/)",
          "end": "\\*/"
        },
        {
          "name": "comment.block.beef",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.documentation.beef",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.beef",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.beef",
          "match": "'(?:[^'\\\\]|\\\\.)'"
        },
        {
          "name": "string.quoted.double.verbatim.beef",
          "begin": "@\\\"",
          "end": "\\\"",
          "patterns": [
            {
              "name": "constant.character.escape.beef",
              "match": "\\\"\\\""
            }
          ]
        },
        {
          "name": "string.quoted.double.interpolated.beef",
          "begin": "\\$\\\"",
          "end": "\\\"",
          "patterns": [
            {
              "name": "constant.character.escape.beef",
              "match": "\\\\."
            },
            {
              "name": "meta.embedded.line.beef",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.beef",
          "begin": "\\\"",
          "end": "\\\"",
          "patterns": [
            {
              "name": "constant.character.escape.beef",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.beef",
          "match": "\\b0[xX][0-9a-fA-F_]+(?:[uU]?[lL]?)?\\b"
        },
        {
          "name": "constant.numeric.binary.beef",
          "match": "\\b0[bB][01_]+(?:[uU]?[lL]?)?\\b"
        },
        {
          "name": "constant.numeric.float.beef",
          "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*)?[eE][+-]?\\d+[fFdD]?\\b"
        },
        {
          "name": "constant.numeric.float.beef",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*(?:[eE][+-]?\\d+)?[fFdD]?\\b"
        },
        {
          "name": "constant.numeric.decimal.beef",
          "match": "\\b\\d[\\d_]*(?:[uU]?[lL]?)?\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.namespace.beef",
          "match": "\\b(namespace)\\s+([A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*)",
          "captures": {
            "1": {
              "name": "keyword.other.namespace.beef"
            },
            "2": {
              "name": "entity.name.namespace.beef"
            }
          }
        },
        {
          "name": "meta.using.beef",
          "match": "\\b(using)\\s+(static\\s+)?([A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*)",
          "captures": {
            "1": {
              "name": "keyword.control.using.beef"
            },
            "2": {
              "name": "storage.modifier.beef"
            },
            "3": {
              "name": "entity.name.namespace.beef"
            }
          }
        },
        {
          "name": "meta.type.class.beef",
          "match": "\\b(class)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.class.beef"
            },
            "2": {
              "name": "entity.name.type.class.beef"
            }
          }
        },
        {
          "name": "meta.type.struct.beef",
          "match": "\\b(struct)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.struct.beef"
            },
            "2": {
              "name": "entity.name.type.struct.beef"
            }
          }
        },
        {
          "name": "meta.type.interface.beef",
          "match": "\\b(interface)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.interface.beef"
            },
            "2": {
              "name": "entity.name.type.interface.beef"
            }
          }
        },
        {
          "name": "meta.type.enum.beef",
          "match": "\\b(enum)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.enum.beef"
            },
            "2": {
              "name": "entity.name.type.enum.beef"
            }
          }
        },
        {
          "name": "meta.type.extension.beef",
          "match": "\\b(extension)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.extension.beef"
            },
            "2": {
              "name": "entity.name.type.extension.beef"
            }
          }
        },
        {
          "name": "meta.function.delegate.beef",
          "match": "\\b(delegate)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.delegate.beef"
            },
            "2": {
              "name": "entity.name.function.beef"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.beef",
          "match": "\\b(if|else|for|while|do|switch|case|default|break|continue|return|goto|try|catch|finally|throw|when|fallthrough)\\b"
        },
        {
          "name": "keyword.other.beef",
          "match": "\\b(this|base|new|delete|scope|append|var|let|null|true|false|typeof|sizeof|decltype|nameof|ref|out|in|params|retval|mut)\\b"
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "name": "storage.modifier.beef",
          "match": "\\b(public|private|protected|internal|static|const|readonly|virtual|override|abstract|sealed|partial|extern|volatile|implicit|explicit|comptime|operator|mixin|function|extension|where)\\b"
        }
      ]
    },
    "primitive-types": {
      "patterns": [
        {
          "name": "storage.type.primitive.beef",
          "match": "\\b(void|bool|char8|char16|char32|int|uint|int8|int16|int32|int64|uint8|uint16|uint32|uint64|float|double)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.destructor.beef",
          "match": "~([A-Za-z_]\\w*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.destructor.beef"
            }
          }
        },
        {
          "name": "entity.name.function.beef",
          "match": "\\b([A-Za-z_]\\w*)\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.splat.beef",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.null-conditional.beef",
          "match": "\\?\\."
        },
        {
          "name": "keyword.operator.arrow.beef",
          "match": "->"
        },
        {
          "name": "keyword.operator.beef",
          "match": "(?:==|!=|<=|>=|&&|\\|\\||<<|>>|\\+\\+|--|[+\\-*/%&|^~!<>=]=?)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.beef",
          "match": "[{}]"
        },
        {
          "name": "punctuation.separator.beef",
          "match": "[()\\[\\];,]"
        }
      ]
    }
  }
}
